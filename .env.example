# Web service configuration
PORT=3000
DATA_DIR=/app/data
AUTO_BACKUP_HOURS=24

# Hermes runtime settings
HERMES_ENABLED=true
HERMES_HOME=/app/.hermes
HERMES_TRADING_MODE=paper
RESTORE_ON_START=true

# Model Providers (Choose one or set NVIDIA / OpenAI / Anthropic / OpenRouter)
# --- NVIDIA NIM API ---
# NVIDIA_API_KEY=nvapi-PASTE_YOUR_NVIDIA_API_KEY_HERE
# OPENAI_API_BASE=https://integrate.api.nvidia.com/v1

# --- Alternative Providers ---
# OPENAI_API_KEY=sk-PASTE_OPENAI_KEY_HERE
# ANTHROPIC_API_KEY=sk-ant-PASTE_ANTHROPIC_KEY_HERE
# OPENROUTER_API_KEY=sk-or-PASTE_OPENROUTER_KEY_HERE
# NOUS_API_KEY=PASTE_NOUS_PORTAL_KEY_HERE

# Optional Webhook Notifications for Signals & Trade Analyses
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=-100123456789
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# GitHub backup system (Repository MUST be private)
BACKUP_REPO=crimsonej/hermes-app-backup
BACKUP_BRANCH=main
GITHUB_TOKEN=PASTE_FINE_GRAINED_GITHUB_TOKEN_HERE

# Trading safety controls
LIVE_TRADING_ENABLED=false
# EXCHANGE_NAME=PASTE_EXCHANGE_NAME_HERE
# EXCHANGE_API_KEY=PASTE_EXCHANGE_KEY_HERE
# EXCHANGE_API_SECRET=PASTE_EXCHANGE_SECRET_HERE
