# Web service configuration
PORT=3000
DATA_DIR=/app/data
AUTO_BACKUP_HOURS=24

# Hermes runtime settings
HERMES_ENABLED=true
HERMES_HOME=/app/.hermes
HERMES_TRADING_MODE=paper
RESTORE_ON_START=true

# NVIDIA API Key & Model endpoint configuration
NVIDIA_API_KEY=nvapi-PASTE_YOUR_NVIDIA_API_KEY_HERE
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1

# Telegram Bot integration
TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER_HERE
TELEGRAM_CHAT_ID=PASTE_YOUR_TELEGRAM_CHAT_ID_HERE
# Set your Telegram User ID (e.g. 123456789) or "*" to allow anyone to chat without verification prompts
TELEGRAM_ALLOWED_USERS="*"

# Private GitHub Backup repository & authentication token
BACKUP_REPO=crimsonej/hermes-app-backup
BACKUP_BRANCH=main
GITHUB_TOKEN=github_pat_PASTE_YOUR_FINE_GRAINED_GITHUB_TOKEN_HERE

# Trading safety controls
LIVE_TRADING_ENABLED=false
# EXCHANGE_NAME=PASTE_EXCHANGE_NAME_HERE
# EXCHANGE_API_KEY=PASTE_EXCHANGE_KEY_HERE
# EXCHANGE_API_SECRET=PASTE_EXCHANGE_SECRET_HERE
