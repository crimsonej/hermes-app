PORT=3000
DATA_DIR=./data
RESTORE_ON_START=true
BACKUP_REPO=yourusername/hermes-app-backup
BACKUP_BRANCH=main
BACKUP_PASSPHRASE=replace-with-a-long-random-passphrase
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Hermes runtime
HERMES_ENABLED=true
HERMES_HOME=/app/.hermes
HERMES_TRADING_MODE=paper

# Set this only when you have deliberately configured a supported exchange.
# LIVE_TRADING_ENABLED=false
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
