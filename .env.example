# Web service
PORT=3000
DATA_DIR=/app/data

# Hermes runtime
HERMES_ENABLED=true
HERMES_HOME=/app/.hermes
HERMES_TRADING_MODE=paper
RESTORE_ON_START=true

# Choose one supported Hermes model provider and fill in its key.
# OPENAI_API_KEY=PASTE_OPENAI_KEY_HERE
# ANTHROPIC_API_KEY=PASTE_ANTHROPIC_KEY_HERE
# OPENROUTER_API_KEY=PASTE_OPENROUTER_KEY_HERE
# NOUS_API_KEY=PASTE_NOUS_PORTAL_KEY_HERE

# GitHub backup (the backup repository must remain private)
BACKUP_REPO=crimsonej/hermes-app-backup
BACKUP_BRANCH=main
GITHUB_TOKEN=PASTE_FINE_GRAINED_GITHUB_TOKEN_HERE

# Trading safety: keep paper mode and live trading disabled during setup.
LIVE_TRADING_ENABLED=false
# EXCHANGE_NAME=PASTE_EXCHANGE_NAME_HERE
# EXCHANGE_API_KEY=PASTE_EXCHANGE_KEY_HERE
# EXCHANGE_API_SECRET=PASTE_EXCHANGE_SECRET_HERE
